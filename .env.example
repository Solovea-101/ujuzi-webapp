# Copy to .env for local runs. Real values live in Render's settings, never in git.
PORT=3000
# PostgreSQL. Leave empty to use the in-memory store (tests, clean clones).
DATABASE_URL=
# Our upstream: Kazi Connect (endpoints 1-9 need no key today)
KAZI_API_URL=https://kaziconnect1-1xmu.onrender.com
KAZI_WS_URL=wss://kaziconnect1-1xmu.onrender.com
# SHA-256 hashes of the X-API-Keys we issue to Sherehe, comma-separated.
# Make a key and its hash with: npm run key:issue -- sherehe  (with none set, partner endpoints answer 401)
PARTNER_KEYS=
SESSION_SECRET=change-me
