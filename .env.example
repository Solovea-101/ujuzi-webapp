# Copy to .env for local runs. Real values live in Render's settings, never in git.
PORT=3000
# PostgreSQL. Leave empty to use the in-memory store (tests, clean clones).
DATABASE_URL=
# Our upstream: Kazi Connect (endpoints 1-9 need no key unless Kazi switches API keys on)
KAZI_API_URL=https://kaziconnect1-1xmu.onrender.com
KAZI_WS_URL=wss://kaziconnect1-1xmu.onrender.com
# Only when Kazi has API keys on: the key Kazi issued to Ujuzi. Sent as X-API-Key on every Kazi call and on its
# WebSocket. Leave empty while Kazi is open. Real value in Render's settings, never in git.
KAZI_API_KEY=
# The X-API-Keys we issue, as name:hash entries, comma-separated: sherehe:<sha-256 of the key>,other:<...>
# The name is whose key it is; a booking belongs to the name on the key that made it. A bare hash is named "default".
# Make a key and its entry with: npm run key:issue -- sherehe  (with none set, partner endpoints answer 401)
PARTNER_KEYS=
SESSION_SECRET=change-me
# Optional. STAFF_INVITE_CODE opens staff sign-up (POST /api/auth/register); with none set it is closed.
STAFF_INVITE_CODE=
# Optional, for demos and the local ring only: SEED_ON_START=true fills an EMPTY database with the sample
# data on start. The seeded fictional accounts all log in with SEED_PASSWORD (default: ujuzi-demo-pass).
SEED_ON_START=
SEED_PASSWORD=
# Rate limits: requests allowed per window (RATE_LIMIT_WINDOW_MS, default 60000). A partner key gets its own
# bucket; everything else is counted per client address; sign-in (login and register) has a tighter one.
# RATE_LIMIT_PARTNER=100  RATE_LIMIT_ANON=120  RATE_LIMIT_LOGIN=10  RATE_LIMIT_WINDOW_MS=60000
# Set TRUST_PROXY=true ONLY behind a proxy that appends the client address to X-Forwarded-For (Render does);
# otherwise every client would share the proxy's address and one bucket. Leave it unset when reached directly.
# TRUST_PROXY_HOPS is how many proxies sit in front of the server (default 1); the client is that many entries
# from the RIGHT of X-Forwarded-For. To find the right number on a new host, set LOG_CLIENT_ADDRESS=true, call
# from two different networks, read the "client-address:" lines in the log, then turn it off (they are addresses).
TRUST_PROXY=
# TRUST_PROXY_HOPS=1
# LOG_CLIENT_ADDRESS=true
# Sign-in lockout: this many wrong passwords in a row (within LOCKOUT_WINDOW_MINUTES) lock an email address for
# LOCKOUT_MINUTES. Kept in the database.
# LOCKOUT_MAX_FAILURES=5  LOCKOUT_WINDOW_MINUTES=15  LOCKOUT_MINUTES=15
# The Week 10 lab handout calls the partner's address and key PARTNER_URL and PARTNER_API_KEY. In Ujuzi, whose one
# upstream is Kazi Connect, they are KAZI_API_URL and KAZI_API_KEY (above). Both are read by the server only; the
# browser never sees them.
# Optional tuning for the Kazi Connect link, in milliseconds (the defaults are the ones to use):
# KAZI_USER_TIMEOUT_MS=10000  KAZI_BACKGROUND_TIMEOUT_MS=60000  KAZI_CACHE_MS=300000  KAZI_POLL_MS=120000
# KAZI_BACKOFF_BASE_MS=1000  KAZI_BACKOFF_MAX_MS=60000
# Week 11, resilience. A read that a person waits on gets KAZI_USER_TIMEOUT_MS in total, spent in attempts of at
# most KAZI_ATTEMPT_TIMEOUT_MS, with KAZI_RETRIES retries after KAZI_RETRY_DELAY_MS (doubling). Writes are never
# retried. When Kazi cannot be reached, the last good job list is shown, flagged as saved, for KAZI_STALE_MS.
# KAZI_ATTEMPT_TIMEOUT_MS=3000  KAZI_RETRIES=2  KAZI_RETRY_DELAY_MS=200  KAZI_STALE_MS=3600000
# Week 12, monitoring. One JSON line per API request is printed (time, method, path, status, ms, caller: never a
# key, a query string or a body). Set LOG_REQUESTS=false to turn it off. GET /api/stats shows the running totals.
# LOG_REQUESTS=true
